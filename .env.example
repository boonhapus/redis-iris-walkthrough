# Redis Iris basics: settings. Copy this file to .env next to pyproject.toml, uncomment the
# names for the columns you want to run, and fill them in.

# ---- AI AGENT ----
LLM_API_KEY=

# ---- Redis ----
# Any Redis 8 with Search and JSON, local or Redis Cloud.
#
# Console: the database's Configuration page (Public endpoint) and its Security
#          page (Default user password). Use rediss:// on a TLS database.
#
REDIS_URL=

# ---- Redis: LangCache ----
# Console: the service's Connectivity page (URL and Cache ID). The API key is shown once, when
#          the service is created. Use a service of your own: a cache is shared by everything
#          that points at it.
#
LANGCACHE_HOST=
LANGCACHE_CACHE_ID=
LANGCACHE_API_KEY=

# ---- Redis: Context Retriever ----
# Console: the Context Retriever Admin keys page. A new key is shown once. The database must have
#          Search and JSON and be reachable by the hosted service, which is given its password.
#
CTX_ADMIN_KEY=

# ---- Redis: Agent Memory ----
# Console: the service's General settings page (Endpoint, with https://, and Store ID) and its
#          API keys page. A new key is shown once.
#
MEMORY_API_BASE_URL=
MEMORY_STORE_ID=
MEMORY_API_KEY=